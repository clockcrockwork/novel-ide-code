registry=https://registry.npmjs.org/
@tiptap:registry=https://registry.npmjs.org/
@eslint:registry=https://registry.npmjs.org/
@types:registry=https://registry.npmjs.org/
@vitejs:registry=https://registry.npmjs.org/
package-lock=true
# 新規公開パッケージを7日間解決しない（semgrep: npm-missing-minimum-release-age）
min-release-age=7
# min-release-age は npm 11.10+ の機能。旧 npm が黙って無視するのを防ぐため engines を強制する
engine-strict=true
