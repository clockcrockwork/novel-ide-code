{
  "name": "novel-ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bench": "vite bench/",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,css}\"",
    "preview": "vite preview",
    "check": "npm run lint && npm run check:thresholds && npm run test",
    "check:thresholds": "node scripts/check-thresholds.js",
    "check:artifacts": "node scripts/agent/check-artifacts.js",
    "check:npm-pin": "node scripts/agent/check-npm-pin-cooldown.js",
    "review:snapshot": "node scripts/agent/review-snapshot.js",
    "review:plan": "node scripts/agent/review-plan.js plan",
    "review:config": "node scripts/agent/review-exec-config.js",
    "review:metrics": "node scripts/agent/review-metrics.js",
    "agents:project": "sh -c 'if [ -z \"$AGENT_COMMONS_PATH\" ]; then echo \"AGENT_COMMONS_PATH が未設定です（agent-commons のローカルチェックアウトのパスを指定してください）\" >&2; exit 1; fi; rev=$(git -C \"$AGENT_COMMONS_PATH\" rev-parse HEAD) || exit 1; if [ -z \"$rev\" ]; then echo \"agent-commons の revision を解決できません（git リポジトリとして clone してください）\" >&2; exit 1; fi; node \"$AGENT_COMMONS_PATH/scripts/project.js\" --manifest agent-manifest.json --commons \"$AGENT_COMMONS_PATH\" --commons-revision \"$rev\" --write \"$@\"' sh",
    "agents:check": "node scripts/agent/verify-projection.js",
    "build:artifacts-gate": "ncc build .github/actions/artifacts-gate/src/index.js -o .github/actions/artifacts-gate/dist --no-source-map-register",
    "check:artifacts-gate-bundle": "npm run build:artifacts-gate && node scripts/check-artifacts-gate-bundle.js",
    "security:semgrep": "semgrep scan --config p/javascript --config p/react --config p/owasp-top-ten --error",
    "security:secrets": "gitleaks git . --redact",
    "security:secrets:strict": "node scripts/gh/run-strict-secret-scan.js",
    "test": "npm run test:vitest && npm run test:node",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:node": "node --test \"tests/**/*.test.js\"",
    "kill-e2e-ports": "node scripts/kill-e2e-ports.js",
    "pretest:e2e": "npm run kill-e2e-ports",
    "test:e2e": "playwright test --grep-invert @heavy",
    "pretest:e2e:all": "npm run kill-e2e-ports",
    "test:e2e:all": "playwright test",
    "pretest:e2e:heavy": "npm run kill-e2e-ports",
    "test:e2e:heavy": "playwright test --grep @heavy",
    "pretest:e2e:perf": "npm run kill-e2e-ports",
    "test:e2e:perf": "playwright test --grep @perf",
    "pretest:e2e:ime": "npm run kill-e2e-ports",
    "test:e2e:ime": "playwright test --grep @ime",
    "analyze:unused": "knip --no-exit-code",
    "analyze:duplicates": "jscpd --config .jscpdrc.json",
    "analyze:deps": "depcruise src",
    "docs:links:check": "node scripts/check-doc-links.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-hard-break": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "virtua": "^0.50.6",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "eslint-plugin-jest-dom": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/ncc": "^0.45.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.11.0",
    "jscpd": "^5.0.15",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "knip": "^6.32.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "npm": ">=11.10.0"
  }
}
